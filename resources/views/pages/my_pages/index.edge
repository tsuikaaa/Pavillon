@layouts.app({ title: 'Mes pages' })
  @page()
    <h1>Mes pages</h1>
    <p>
      <a href="{{ route('pages.create') }}" class="btn btn--secondary btn--sm">Nouvelle page</a>
    </p>

    @if(pages.length === 0)
      <p>Tu n'as pas encore de page. Crée la première.</p>
    @else
      <ul style="list-style: none; padding: 0; display: grid; gap: 12px;">
        @each(page in pages)
          <li style="border: 1px solid var(--border, #ddd); border-radius: 8px; padding: 12px;">
            <strong>{{ page.title }}</strong>
            <span class="mono" style="font-size: 12.5px;">/p/{{ page.slug }}</span>
            <div style="font-size: 13px;">{{ page.$extras.links_count }} lien(s)</div>
            <div style="display: flex; gap: 8px; margin-top: 8px;">
              <a href="/p/{{ page.slug }}" class="btn btn--secondary btn--sm" target="_blank">Voir</a>
              <a href="{{ route('pages.edit', { id: page.id }) }}" class="btn btn--secondary btn--sm">Modifier</a>
              <form
                method="POST"
                action="{{ route('pages.destroy', { id: page.id }) }}"
                onsubmit="return confirm('Supprimer cette page ? Ses liens seront conservés.')"
              >
                {{ csrfField() }}
                <button type="submit" class="btn btn--secondary btn--sm">Supprimer</button>
              </form>
            </div>
          </li>
        @end
      </ul>
    @end
  @end
@end