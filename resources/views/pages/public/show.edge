<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page.title }}</title>
  <meta name="description" content="{{ page.description || page.title }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Nunito:wght@600;800&display=swap"
    rel="stylesheet" />
  @vite(['resources/css/app.css'])
  <style>
    :root {
      --pink: #f7dce5;
      --pink-soft: #fbc4d4;
      --pink-strong: #ef8fb3;
      --brown: #3b2626;
      --cream: #fff3f6;
      --red: #d4202a;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'Nunito', system-ui, sans-serif;
      color: var(--brown);
      background-color: var(--pink);
      background-image:
        radial-gradient(var(--brown) 7px, transparent 7.5px),
        radial-gradient(var(--brown) 7px, transparent 7.5px);
      background-size: 64px 64px;
      background-position: 0 0, 32px 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 72px 16px 40px;
      box-sizing: border-box;
    }

    .card {
      position: relative;
      width: 100%;
      max-width: 440px;
      background: var(--cream);
      border: 3px solid var(--brown);
      border-radius: 32px;
      box-shadow: 8px 8px 0 var(--brown);
      padding: 72px 24px 56px;
      text-align: center;
    }

    /* Bordure dentelle en bas de la carte */
    .card::after {
      content: '';
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 12px;
      height: 14px;
      background:
        radial-gradient(circle at 8px 0, transparent 6px, var(--brown) 6.5px, var(--brown) 8px, transparent 8.5px) 0 0 / 16px 14px repeat-x;
      opacity: 0.7;
    }

    /* Médaillon festonné avec l'initiale */
    .badge {
      position: absolute;
      top: -58px;
      left: 50%;
      transform: translateX(-50%);
      width: 116px;
      height: 116px;
    }

    .badge svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .badge__inner {
      position: absolute;
      inset: 20px;
      border-radius: 50%;
      background: var(--pink-strong);
      border: 3px solid var(--cream);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Dancing Script', cursive;
      font-size: 46px;
      line-height: 1;
      color: var(--brown);
    }

    .flower {
      position: absolute;
      width: 48px;
      height: 48px;
    }

    .flower--left {
      top: -22px;
      left: 10px;
      transform: rotate(-12deg);
    }

    .flower--right {
      top: -16px;
      right: 10px;
      transform: rotate(18deg);
      width: 38px;
      height: 38px;
    }

    /* Bandeau rose en pilule avec coccinelle */
    .banner {
      position: relative;
      margin: 8px 0 14px;
      padding: 14px 24px 14px 52px;
      background: var(--pink-soft);
      border: 2px solid var(--brown);
      border-radius: 999px;
      box-shadow: 4px 4px 0 var(--brown);
    }

    .banner .bug {
      position: absolute;
      left: -14px;
      top: -16px;
      width: 48px;
      height: 48px;
      transform: rotate(-20deg);
    }

    .title {
      font-family: 'Dancing Script', cursive;
      font-size: 34px;
      line-height: 1.1;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .desc {
      margin: 0 0 28px;
      font-weight: 600;
      line-height: 1.5;
      opacity: 0.85;
    }

    .links {
      display: grid;
      gap: 14px;
    }

    .link-btn {
      display: block;
      padding: 15px 20px;
      border: 2px solid var(--brown);
      border-radius: 999px;
      background: var(--pink-strong);
      color: var(--brown);
      font-weight: 800;
      font-size: 16px;
      text-decoration: none;
      box-shadow: 4px 4px 0 var(--brown);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .link-btn:nth-child(even) {
      background: var(--brown);
      color: var(--cream);
      box-shadow: 4px 4px 0 var(--pink-strong);
    }

    .link-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--brown);
    }

    .link-btn:nth-child(even):hover {
      box-shadow: 6px 6px 0 var(--pink-strong);
    }

    .link-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 var(--brown);
    }

    .link-btn:focus-visible {
      outline: 3px dotted var(--brown);
      outline-offset: 3px;
    }

    .empty {
      font-weight: 600;
      opacity: 0.8;
    }

    .footer {
      margin: 28px 0 0;
      font-size: 13px;
      font-weight: 600;
      opacity: 0.7;
    }

    .back {
      position: fixed;
      bottom: 16px;
      left: 16px;
      z-index: 10;
      display: inline-block;
      padding: 10px 18px;
      border: 2px solid var(--brown);
      border-radius: 999px;
      background: var(--cream);
      color: var(--brown);
      font-weight: 800;
      font-size: 14px;
      text-decoration: none;
      box-shadow: 3px 3px 0 var(--brown);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .back:hover {
      transform: translate(-1px, -1px);
      box-shadow: 5px 5px 0 var(--brown);
    }

    .back:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 var(--brown);
    }

    .back:focus-visible {
      outline: 3px dotted var(--brown);
      outline-offset: 3px;
    }
  </style>
</head>

<body>
  @if(auth.user)
  <a href="{{ route('dashboard') }}" class="back">← Dashboard</a>
  @else
  <a href="{{ route('home') }}" class="back">← Retour</a>
  @end
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
    <symbol id="flower" viewBox="0 0 100 100">
      <g fill="#ef8fb3" stroke="#3b2626" stroke-width="4">
        <circle cx="50" cy="22" r="18" />
        <circle cx="78" cy="42" r="18" />
        <circle cx="67" cy="75" r="18" />
        <circle cx="33" cy="75" r="18" />
        <circle cx="22" cy="42" r="18" />
      </g>
      <circle cx="50" cy="52" r="13" fill="#fff3f6" stroke="#3b2626" stroke-width="4" />
    </symbol>

    <symbol id="ladybug" viewBox="0 0 100 100">
      <circle cx="40" cy="50" r="30" fill="#1a1010" />
      <path d="M44 20 A32 32 0 1 1 44 80 L58 50 Z" fill="#d4202a" stroke="#8c1119" stroke-width="3" />
      <g fill="#1a1010">
        <circle cx="62" cy="34" r="4.5" />
        <circle cx="74" cy="52" r="4.5" />
        <circle cx="62" cy="68" r="4.5" />
        <circle cx="52" cy="50" r="3.5" />
      </g>
      <path d="M30 22 Q26 10 18 8 M36 20 Q38 8 46 4" stroke="#1a1010" stroke-width="3" fill="none" />
    </symbol>

    <symbol id="scallop" viewBox="0 0 120 120">
      <g fill="#3b2626">
        <circle cx="60" cy="10" r="10" />
        <circle cx="82" cy="14" r="10" />
        <circle cx="100" cy="28" r="10" />
        <circle cx="110" cy="50" r="10" />
        <circle cx="110" cy="70" r="10" />
        <circle cx="100" cy="92" r="10" />
        <circle cx="82" cy="106" r="10" />
        <circle cx="60" cy="110" r="10" />
        <circle cx="38" cy="106" r="10" />
        <circle cx="20" cy="92" r="10" />
        <circle cx="10" cy="70" r="10" />
        <circle cx="10" cy="50" r="10" />
        <circle cx="20" cy="28" r="10" />
        <circle cx="38" cy="14" r="10" />
        <circle cx="60" cy="60" r="50" />
      </g>
      <circle cx="60" cy="60" r="44" fill="none" stroke="#f7dce5" stroke-width="3" stroke-dasharray="1 7"
        stroke-linecap="round" />
    </symbol>
  </svg>

  <main class="card">
    <svg class="flower flower--left">
      <use href="#flower" />
    </svg>
    <svg class="flower flower--right">
      <use href="#flower" />
    </svg>

    <div class="badge">
      <svg>
        <use href="#scallop" />
      </svg>
      <div class="badge__inner">{{ page.title.charAt(0).toUpperCase() }}</div>
    </div>

    <div class="banner">
      <svg class="bug">
        <use href="#ladybug" />
      </svg>
      <h1 class="title">{{ page.title }}</h1>
    </div>

    @if(page.description)
    <p class="desc">{{ page.description }}</p>
    @end

    @if(links.length === 0)
    <p class="empty">Aucun lien pour le moment.</p>
    @else
    <div class="links">
      @each(link in links)
      <a href="{{ link.url }}" class="link-btn" target="_blank" rel="noopener noreferrer nofollow">
        {{ link.label }}
      </a>
      @end
    </div>
    @end

    <p class="footer">Créé avec Pavillon</p>
  </main>
</body>

</html>