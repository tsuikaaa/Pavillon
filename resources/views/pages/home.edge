@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--ok);">
          <span class="dot"></span>
          Pavillon
        </span>
      </div>

      <div class="pc-lead">Tous tes liens, sur une seule page.</div>

      <p class="pc-para">
        Crée ta page, ajoute tes liens, et partage une adresse unique avec tout le monde.
        Pas besoin de savoir coder.
      </p>

      <p class="pc-para">
        Choisis quels liens sont publics, range-les dans l'ordre alphabétique, et modifie-les quand tu veux.
      </p>

      <ul class="links">
        <li>
          <a class="lrow" href="/signup">
            <span class="lrow__bullet"></span>
            <span class="lrow__title">Créer mon compte</span>
            <span class="lrow__desc">C'est gratuit et rapide</span>
            <span class="lrow__arrow">
              @svg('lucide:arrow-up-right', { width: 16, height: 16 })
            </span>
          </a>
        </li>
        <li>
          <a class="lrow" href="/login">
            <span class="lrow__bullet"></span>
            <span class="lrow__title">Se connecter</span>
            <span class="lrow__desc">Retrouve tes pages et tes liens</span>
            <span class="lrow__arrow">
              @svg('lucide:arrow-up-right', { width: 16, height: 16 })
            </span>
          </a>
        </li>
      </ul>
    </article>
  </div>
@end