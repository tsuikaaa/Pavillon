@layouts.auth()
  <h1 class="auth__title">Crée ton compte</h1>
  <p class="auth__sub">Crée ta page et partage tous tes liens.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Nom complet' })
      @!input.control({ autocomplete: 'name', placeholder: 'Marinette Dupain-Cheng' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'E-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'toi@exemple.fr',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Créer mon compte',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Un instant…' : 'Créer mon compte'",
    })
  @end

  <p class="auth__foot">
    Tu as déjà un compte ?
    @link({ route: 'session.create', class: 'il' })
      Se connecter
    @end
  </p>
@end