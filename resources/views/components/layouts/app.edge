@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Pavillon` : 'Pavillon' }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Nunito:wght@600;800&display=swap" rel="stylesheet" />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="shell">
      <header class="shell__header">
        @!logo({ size: 30 })
        @form({ route: 'session.destroy', method: 'POST', style: 'margin: 0;' })
          <button type="submit" class="btn btn--ghost btn--sm">Se déconnecter</button>
        @end
      </header>

      <main class="shell__main">
        <div class="shell__card">
          {{{ await $slots.main() }}}
        </div>
      </main>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>